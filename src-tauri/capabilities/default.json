{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main Scribble window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "core:webview:default",
    "deep-link:default",
    "shell:allow-open",
    "dialog:default",
    "global-shortcut:default",
    "updater:default",
    "process:default"
  ]
}
